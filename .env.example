# متغیرهای محیطی — این فایل را کپی کن و مقدار واقعی بگذار
# cp .env.example .env

# در Vercel از Environment Variables استفاده کن، نه فایل .env

# نام کانال و گروه تلگرام
CHANNEL=Bamboodrop
GROUP=Bamboodropgroup

# Upstash Redis (https://console.upstash.com) — برای ثبت‌نام ایمیل
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
